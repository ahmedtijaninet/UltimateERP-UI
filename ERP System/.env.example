# Environment variables for the ERP System

# -- DATABASE --
DB_HOST=localhost
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=erp_system
DB_CHARSET=utf8mb4

# -- APPLICATION --
SITE_NAME="ERP System"
